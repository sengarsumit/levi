      "name": "00 Setup",
      "item": [
        {
          "name": "Initialize Run Variables",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString();",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('signupEmail', `levi.user.${runId}@example.com`);",
                  "pm.collectionVariables.set('signupPassword', 'Password@123');",
                  "pm.collectionVariables.set('orgName', `Levi Org ${runId}`);",
                  "pm.collectionVariables.set('projectName', `Levi Project ${runId}`);",
                  "pm.collectionVariables.unset('accessToken');",
                  "pm.collectionVariables.unset('refreshToken');",
                  "pm.collectionVariables.unset('tenantId');",
                  "pm.collectionVariables.unset('currentUserId');",
                  "pm.collectionVariables.unset('projectId');",
                  "pm.collectionVariables.unset('issueId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Variables initialized', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.collectionVariables.get('signupEmail')).to.include('@example.com');",
                  "  pm.expect(pm.collectionVariables.get('signupPassword')).to.eql('Password@123');",
                  "});",
                  "console.log('Run email:', pm.collectionVariables.get('signupEmail'));"
                ]
              }
            }
          ],
