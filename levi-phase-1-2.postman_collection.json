              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List users returns 200', function () { pm.response.to.have.status(200); });",
                  "const users = pm.response.json();",
                  "const email = pm.collectionVariables.get('signupEmail');",
                  "const user = users.find(u => u.email === email);",
                  "pm.test('Created user is present and has systemId', function () {",
                  "  pm.expect(user, `User ${email} should exist`).to.exist;",
                  "  pm.expect(user.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(user.systemId).to.match(/^USR-\\d+$/);",
                  "});",
                  "pm.collectionVariables.set('currentUserId', user.id);"
